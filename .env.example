# Copy to .env (ignored by git) and adapt. Load it with: uv run --env-file .env inbox-planner ...
# Nothing secret goes in this file: secrets and tokens live in INBOX_PLANNER_HOME, outside the repo.

# Folder for OAuth tokens, the model-answer cache for real mail, and the SQLite database.
INBOX_PLANNER_HOME=~/.inbox-planner

# OAuth client downloaded from Google Cloud (Desktop app). Never commit it.
GOOGLE_CLIENT_SECRET_FILE=~/.inbox-planner/google-client-secret.json

# Your current time zone and town (added to map searches when a place has no town).
INBOX_PLANNER_TIMEZONE=America/Los_Angeles
INBOX_PLANNER_MAP_AREA=Corvallis, OR

# Optional: SQLite database URL (default: sqlite:///~/.inbox-planner/inbox-planner.db).
# INBOX_PLANNER_DB=sqlite:////absolute/path/inbox-planner.db

# Only for the optional Anthropic API client (never needed for the demo).
# ANTHROPIC_API_KEY=
